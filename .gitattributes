* text=auto eol=lf
docs/evidence/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/reviews/approved-candidate-manifest.json -text whitespace=cr-at-eol
# Preserve immutable P3a review receipts/logs exactly, not production whitespace.
docs/reviews/p3a-*/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
# Historical handoff bytes retained; do not relax executable whitespace.
docs/P3A_BACKEND_A1_HANDOFF.md -text whitespace=-blank-at-eof,cr-at-eol

# Immutable P3b source receipts and approvals retain their original bytes.
P3B_Q_REPAIR_PROGRESS.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/P3B_FINISH_SOURCES.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/reviews/p3b-spec-q/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/reviews/p3b-quality-q/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# P3c source approval receipts retain their reviewed bytes.
docs/reviews/p3c-spec-r4/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/reviews/p3c-quality-r4/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
